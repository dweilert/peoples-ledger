  "claims": [
    {
      "id": "claim_representative_subset_scope",
      "claim": "The manual exemplar covers ten representative TCJA provisions across individual, business, estate, and international tax areas without claiming complete analysis of the law.",
      "claim_type": "descriptive",
      "confidence": "high",
      "publication_state": "source_verified",
      "evidence": [
        { "source_record_id": "pl115_97_public_law", "locator": "Sections 11001, 11011, 11021, 11022, 11041, 11042, 11061, 13001, 13201, 14103, 14201, 14202, and 14401", "support": "supports" }
      ]
    },
    {
      "id": "claim_distribution_varies",
      "claim": "Expected effects vary across taxpayer groups, filing choices, business forms, asset ownership, and international exposure, so the POC records uncertainty rather than estimating household outcomes.",
      "claim_type": "distributional",
      "confidence": "medium",
      "publication_state": "provisional_analysis",
      "evidence": [
        { "source_record_id": "jct_tcja_distribution_2017", "locator": "Distributional tables and accompanying notes", "support": "supports" },
        { "source_record_id": "crs_salt_cap_2018", "locator": "Overview and policy discussion", "support": "qualifies" }
      ]
    },
    {
      "id": "claim_sunset_interactions",
      "claim": "Several individual provisions are temporary while selected business and international provisions have different timing, creating interaction and budget-window questions for later modeling.",
      "claim_type": "uncertainty",
      "confidence": "medium",
      "publication_state": "provisional_analysis",
      "evidence": [
        { "source_record_id": "pl115_97_public_law", "locator": "Effective-date and sunset language in selected provisions", "support": "supports" },
        { "source_record_id": "jct_tcja_distribution_2017", "locator": "Conference agreement distributional analysis", "support": "qualifies" }
      ]
    }
  ],
  "narrow_benefit_indicators": [
    {
      "id": "indicator_geographic_concentration",
      "label": "Geographic concentration",
      "signal": "possible",
      "rationale": "The SALT deduction cap is connected to state and local tax exposure, so benefits and burdens may be geographically uneven.",
      "evidence_ids": ["claim_distribution_varies"]
    },
    {
      "id": "indicator_entity_form_advantage",
