      "signal": "possible",
      "rationale": "The QBI deduction and selected business provisions may make legal form and business classification material to outcomes.",
      "evidence_ids": ["claim_distribution_varies"]
    },
    {
      "id": "indicator_sunset_budget_window",
      "label": "Sunset / budget-window effect",
      "signal": "strong",
      "rationale": "Multiple individual provisions in the exemplar have temporary effective windows, making sunset treatment central to interpretation.",
      "evidence_ids": ["claim_sunset_interactions"]
    },
    {
      "id": "indicator_household_specific_exclusion",
      "label": "Household-specific exclusion",
      "signal": "unknown",
      "rationale": "The POC does not evaluate household records and therefore cannot classify individual household effects.",
      "evidence_ids": ["claim_representative_subset_scope"]
    }
  ],
  "model_scenarios": [
    {
      "id": "canonical_base_v1",
      "label": "Canonical current-law base qualitative screen",
      "version": "1.0",
      "methods_owner": "The People's Ledger methods group",
      "baseline_id": "current-law-2017-11-01",
      "data_vintage": "2017-11",
      "time_horizons": [1, 5, 10],
      "model_type": "qualitative",
      "assumptions": [
        "Only public statutory text and public aggregate analyses are used.",
        "No household financial records are collected, transmitted, or stored.",
        "The scenario identifies questions for later modeling rather than estimating household tax liability.",
        "Provision interactions are recorded as qualitative dependencies until deterministic models exist."
      ],
      "outputs": [
        "Flag representative provisions for aggregate distributional review.",
        "Record uncertainty around timing, sunsets, itemization, business form, asset ownership, and international exposure.",
        "Preserve source spans and statutory-transformation records for each provision."
      ],
      "uses_household_financial_data": false,
      "approval_record": "methods-approval-poc-001",
      "limitations": [
        "This scenario identifies qualitative questions only.",
        "It does not estimate taxpayer liability or distributional magnitudes.",
        "It is not a complete analysis of Public Law 115-97."
      ]
    }
  ],
