{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_promotion_request.schema.json",
  "title": "Candidate Promotion Request",
  "type": "object",
  "required": [
    "id",
    "candidate_analysis_unit_id",
    "phase",
    "request_status",
    "target_publication_state",
    "requested_at",
    "requested_by",
    "promotion_contract_ref",
    "required_gates",
    "current_blockers",
    "candidate_source_refs",
    "execution_policy",
    "privacy"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "candidate_analysis_unit_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "phase": { "type": "string", "enum": ["phase2_promotion_request_stub"] },
    "request_status": { "type": "string", "enum": ["blocked"] },
    "target_publication_state": { "type": "string", "enum": ["provisional_analysis"] },
    "requested_at": { "type": "string", "minLength": 1 },
    "requested_by": { "type": "string", "minLength": 1 },
    "promotion_contract_ref": { "type": "string", "minLength": 1 },
    "required_gates": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "schema",
          "source",
          "extraction_prompt",
          "privacy",
          "human_review",
          "ledger",
          "public_report",
          "risk"
        ]
      }
    },
    "current_blockers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["gate", "reason"],
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "prompt_template",
              "human_review",
              "ledger",
              "promotion_disabled"
            ]
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "candidate_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_record_id", "content_hash"],
        "additionalProperties": false,
        "properties": {
          "source_record_id": { "type": "string", "minLength": 1 },
          "content_hash": { "type": "string", "minLength": 1 }
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "required": [
        "promotion_execution_allowed",
        "public_report_inclusion_allowed",
        "ledger_append_allowed",
        "live_provider_allowed",
        "household_financial_data_allowed"
      ],
      "additionalProperties": false,
      "properties": {
        "promotion_execution_allowed": { "type": "boolean", "enum": [false] },
        "public_report_inclusion_allowed": { "type": "boolean", "enum": [false] },
        "ledger_append_allowed": { "type": "boolean", "enum": [false] },
        "live_provider_allowed": { "type": "boolean", "enum": [false] },
        "household_financial_data_allowed": { "type": "boolean", "enum": [false] }
      }
    },
    "privacy": {
      "type": "object",
      "required": ["uses_household_financial_data", "egress_allowed", "notes"],
      "additionalProperties": false,
      "properties": {
        "uses_household_financial_data": { "type": "boolean", "enum": [false] },
        "egress_allowed": { "type": "boolean", "enum": [false] },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
