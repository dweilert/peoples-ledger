{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate_extraction_policy.schema.json",
  "title": "Candidate Extraction Policy",
  "type": "object",
  "required": [
    "id",
    "version",
    "status",
    "provider",
    "model",
    "live_provider_authorized",
    "allowed_tasks",
    "required_candidate_source_refs",
    "template",
    "privacy_constraints",
    "promotion_use_allowed"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "version": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["draft", "approved_for_dry_run", "retired"] },
    "provider": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "live_provider_authorized": { "type": "boolean" },
    "allowed_tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "required_candidate_source_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "template": { "type": "string", "minLength": 1 },
    "privacy_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "promotion_use_allowed": { "type": "boolean" }
  }
}
