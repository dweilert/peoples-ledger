{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "narrow_benefit_indicator.schema.json",
  "title": "Narrow-Benefit Indicator",
  "type": "object",
  "required": ["id", "label", "signal", "rationale", "evidence_ids"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "label": { "type": "string", "minLength": 1 },
    "signal": { "type": "string", "enum": ["none", "possible", "strong", "unknown"] },
    "rationale": { "type": "string", "minLength": 1 },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
