{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_ingestion_fixture.schema.json",
  "title": "Source Ingestion Fixture",
  "type": "object",
  "required": [
    "id",
    "title",
    "publisher",
    "url",
    "snapshot_date",
    "retrieved_at",
    "source_type",
    "snapshot_method",
    "locator_policy",
    "raw_snapshot_text",
    "expected_content_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "minLength": 1 },
    "snapshot_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "retrieved_at": { "type": "string", "minLength": 1 },
    "source_type": {
      "type": "string",
      "enum": ["statute", "committee_report", "government_analysis", "agency_guidance", "academic", "other"]
    },
    "snapshot_method": { "type": "string", "enum": ["manual", "downloaded", "api"] },
    "locator_policy": { "type": "string", "minLength": 1 },
    "raw_snapshot_text": { "type": "string", "minLength": 1 },
    "expected_content_hash": { "type": "string", "minLength": 1 }
  }
}
