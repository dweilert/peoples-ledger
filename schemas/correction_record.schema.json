{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "correction_record.schema.json",
  "title": "Correction Record",
  "type": "object",
  "required": [
    "id",
    "analysis_unit_id",
    "target_ref",
    "correction_type",
    "root_cause",
    "previous_output_ref",
    "corrected_output_ref",
    "regression_test_ref",
    "supersedes_decision_id",
    "source_record_ids",
    "publication_state"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^corr_[a-z0-9_-]+$" },
    "analysis_unit_id": { "type": "string", "minLength": 1 },
    "target_ref": { "type": "string", "minLength": 1 },
    "correction_type": {
      "type": "string",
      "enum": ["source_locator", "claim_text", "indicator", "transformation", "publication_state", "other"]
    },
    "root_cause": { "type": "string", "minLength": 1 },
    "previous_output_ref": { "type": "string", "minLength": 1 },
    "corrected_output_ref": { "type": "string", "minLength": 1 },
    "regression_test_ref": { "type": "string", "minLength": 1 },
    "supersedes_decision_id": { "type": "string", "minLength": 1 },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "publication_state": {
      "type": "string",
      "enum": ["corrected", "superseded"]
    }
  }
}
