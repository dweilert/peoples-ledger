{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provision.schema.json",
  "title": "Provision",
  "type": "object",
  "required": ["id", "legislative_document_id", "label", "summary", "policy_area", "source_record_ids"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "legislative_document_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "policy_area": { "type": "string", "minLength": 1 },
    "effective_window": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end": { "type": ["string", "null"] }
      }
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
