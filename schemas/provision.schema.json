{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "provision.schema.json",
  "title": "Provision",
  "type": "object",
  "required": [
    "id",
    "analysis_unit_id",
    "legislative_document_id",
    "label",
    "summary",
    "policy_area",
    "baseline_id",
    "source_spans",
    "source_record_ids",
    "publication_state",
    "decision_ids"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "analysis_unit_id": { "type": "string", "minLength": 1 },
    "legislative_document_id": { "type": "string", "minLength": 1 },
    "label": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "policy_area": { "type": "string", "minLength": 1 },
    "baseline_id": { "type": "string", "minLength": 1 },
    "effective_window": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end": { "type": ["string", "null"] }
      }
    },
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "source_spans": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_record_id", "locator", "text_hash"],
        "additionalProperties": false,
        "properties": {
          "source_record_id": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "text_hash": { "type": "string", "minLength": 1 }
        }
      }
    },
    "publication_state": {
      "type": "string",
      "enum": ["source_verified", "machine_parsed", "provisional_analysis", "analyst_verified", "expert_reviewed", "corrected", "superseded"]
    },
    "decision_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
