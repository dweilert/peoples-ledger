{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai_decision_ledger_entry.schema.json",
  "title": "AI Decision Ledger Entry",
  "type": "object",
  "required": [
    "id",
    "timestamp",
    "previous_entry_hash",
    "analysis_unit_id",
    "actor",
    "decision_type",
    "model",
    "prompt_template_version",
    "source_snapshot_ids",
    "source_hashes",
    "baseline_id",
    "model_scenario_id",
    "perspective_id",
    "structured_input_pointer",
    "input_storage_class",
    "input_retention_days",
    "structured_output",
    "calibrated_confidence",
    "model_disagreement",
    "validation_results",
    "risk_tier",
    "publication_lane",
    "publication_state",
    "human_review_required",
    "review_triggers",
    "disclosure_class",
    "redaction_reason",
    "supersedes_decision_id",
    "deletion_authorization",
    "action",
    "input_refs",
    "output_refs",
    "rationale",
    "household_financial_data_present",
    "entry_hash"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^adl_[a-z0-9_-]+$" },
    "timestamp": { "type": "string", "minLength": 1 },
    "previous_entry_hash": { "type": ["string", "null"] },
    "analysis_unit_id": { "type": "string", "minLength": 1 },
    "actor": { "type": "string", "minLength": 1 },
    "decision_type": { "type": "string", "minLength": 1 },
    "model": {
      "type": "object",
      "required": ["provider", "name", "version"],
      "additionalProperties": false,
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "prompt_template_version": { "type": "string", "minLength": 1 },
    "source_snapshot_ids": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "source_hashes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "baseline_id": { "type": "string", "minLength": 1 },
    "model_scenario_id": { "type": "string", "minLength": 1 },
    "perspective_id": { "type": ["string", "null"] },
    "structured_input_pointer": { "type": "string", "minLength": 1 },
    "input_storage_class": { "type": "string", "enum": ["none", "restricted_pointer", "public_summary"] },
    "input_retention_days": { "type": "integer" },
    "structured_output": { "type": "object" },
    "calibrated_confidence": { "type": "number" },
    "model_disagreement": { "type": "number" },
    "validation_results": {
      "type": "object",
      "required": [
        "schema_valid",
        "citations_valid",
        "statutory_transform_valid",
        "calculation_valid",
        "privacy_egress_valid",
        "perspective_invariance_valid"
      ],
      "additionalProperties": false,
      "properties": {
        "schema_valid": { "type": "boolean" },
        "citations_valid": { "type": "boolean" },
        "statutory_transform_valid": { "type": "boolean" },
        "calculation_valid": { "type": "boolean" },
        "privacy_egress_valid": { "type": "boolean" },
        "perspective_invariance_valid": { "type": "boolean" }
      }
    },
    "risk_tier": { "type": "integer" },
    "publication_lane": { "type": "string", "enum": ["factual", "provisional_analytical", "verified_impact"] },
    "publication_state": {
      "type": "string",
      "enum": ["source_verified", "machine_parsed", "provisional_analysis", "analyst_verified", "expert_reviewed", "corrected", "superseded"]
    },
    "human_review_required": { "type": "boolean" },
    "review_triggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "disclosure_class": { "type": "string", "enum": ["public_summary", "restricted", "redacted"] },
    "redaction_reason": { "type": ["string", "null"] },
    "supersedes_decision_id": { "type": ["string", "null"] },
    "deletion_authorization": { "type": ["string", "null"] },
    "action": { "type": "string", "minLength": 1 },
    "input_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "output_refs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "rationale": { "type": "string", "minLength": 1 },
    "household_financial_data_present": { "type": "boolean" },
    "entry_hash": { "type": "string", "minLength": 1 }
  }
}
