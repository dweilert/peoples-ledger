{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source_acquisition_manifest.schema.json",
  "title": "Source Acquisition Manifest",
  "type": "object",
  "required": [
    "id",
    "label",
    "phase",
    "candidate_publication_state",
    "report_visibility",
    "retrieval_policy",
    "sources"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "label": { "type": "string", "minLength": 1 },
    "phase": { "type": "string", "enum": ["phase2_source_acquisition"] },
    "candidate_publication_state": { "type": "string", "enum": ["draft", "machine_parsed"] },
    "report_visibility": { "type": "string", "enum": ["excluded_until_promoted"] },
    "retrieval_policy": {
      "type": "object",
      "required": ["mode", "network_allowed", "storage_mode"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["fixture_only", "downloaded", "api"] },
        "network_allowed": { "type": "boolean" },
        "storage_mode": { "type": "string", "enum": ["metadata_only", "local_file", "external_pointer"] }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "publisher",
          "url",
          "snapshot_date",
          "retrieved_at",
          "source_type",
          "snapshot_method",
          "locator_policy",
          "raw_snapshot_text",
          "expected_content_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
          "title": { "type": "string", "minLength": 1 },
          "publisher": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "snapshot_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "retrieved_at": { "type": "string", "minLength": 1 },
          "source_type": {
            "type": "string",
            "enum": ["statute", "committee_report", "government_analysis", "agency_guidance", "academic", "other"]
          },
          "snapshot_method": { "type": "string", "enum": ["manual", "downloaded", "api"] },
          "locator_policy": { "type": "string", "minLength": 1 },
          "raw_snapshot_text": { "type": "string", "minLength": 1 },
          "expected_content_hash": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
