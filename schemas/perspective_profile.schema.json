{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "perspective_profile.schema.json",
  "title": "Perspective Profile",
  "type": "object",
  "required": [
    "id",
    "label",
    "version",
    "author",
    "source_documents",
    "priorities",
    "questions",
    "reporting_emphasis",
    "permitted_model_scenarios",
    "hard_constraints",
    "limitations",
    "weighting_notes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "label": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "author": { "type": "string", "minLength": 1 },
    "source_documents": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "priorities": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "reporting_emphasis": {
      "type": "object",
      "required": ["preferred_horizons"],
      "additionalProperties": false,
      "properties": {
        "preferred_horizons": {
          "type": "array",
          "items": { "type": "integer" }
        }
      }
    },
    "permitted_model_scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "hard_constraints": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "weighting_notes": { "type": "string", "minLength": 1 }
  }
}
