{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_scenario.schema.json",
  "title": "Model Scenario",
  "type": "object",
  "required": [
    "id",
    "label",
    "version",
    "methods_owner",
    "baseline_id",
    "data_vintage",
    "time_horizons",
    "model_type",
    "assumptions",
    "outputs",
    "uses_household_financial_data",
    "approval_record",
    "limitations"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "label": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "methods_owner": { "type": "string", "minLength": 1 },
    "baseline_id": { "type": "string", "minLength": 1 },
    "data_vintage": { "type": "string", "minLength": 1 },
    "time_horizons": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "integer" }
    },
    "model_type": { "type": "string", "enum": ["qualitative", "aggregate_distributional", "microsimulation_stub"] },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "uses_household_financial_data": { "type": "boolean" },
    "approval_record": { "type": "string", "minLength": 1 },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
