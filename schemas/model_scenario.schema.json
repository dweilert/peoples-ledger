{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "model_scenario.schema.json",
  "title": "Model Scenario",
  "type": "object",
  "required": ["id", "label", "model_type", "assumptions", "outputs", "uses_household_financial_data"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "label": { "type": "string", "minLength": 1 },
    "model_type": { "type": "string", "enum": ["qualitative", "aggregate_distributional", "microsimulation_stub"] },
    "assumptions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "uses_household_financial_data": { "type": "boolean" }
  }
}
