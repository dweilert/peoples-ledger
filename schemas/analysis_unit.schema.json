{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis_unit.schema.json",
  "title": "Analysis Unit",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "legislative_document",
    "provisions",
    "statutory_transformations",
    "claims",
    "narrow_benefit_indicators",
    "model_scenarios",
    "perspective_profiles",
    "expected_outputs"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["manual_exemplar", "draft", "validated"] },
    "legislative_document": { "$ref": "legislative_document.schema.json" },
    "provisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "provision.schema.json" }
    },
    "statutory_transformations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "statutory_transformation.schema.json" }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "claim_evidence.schema.json" }
    },
    "narrow_benefit_indicators": {
      "type": "array",
      "items": { "$ref": "narrow_benefit_indicator.schema.json" }
    },
    "model_scenarios": {
      "type": "array",
      "items": { "$ref": "model_scenario.schema.json" }
    },
    "perspective_profiles": {
      "type": "array",
      "items": { "$ref": "perspective_profile.schema.json" }
    },
    "expected_outputs": {
      "type": "object",
      "required": ["plain_language_summary", "known_limits"],
      "additionalProperties": false,
      "properties": {
        "plain_language_summary": { "type": "string", "minLength": 1 },
        "known_limits": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
