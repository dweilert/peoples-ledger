{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claim_evidence.schema.json",
  "title": "Claim and Evidence",
  "type": "object",
  "required": ["id", "claim", "claim_type", "confidence", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "claim": { "type": "string", "minLength": 1 },
    "claim_type": { "type": "string", "enum": ["descriptive", "distributional", "procedural", "uncertainty"] },
    "confidence": { "type": "string", "enum": ["low", "medium", "high"] },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_record_id", "locator", "support"],
        "additionalProperties": false,
        "properties": {
          "source_record_id": { "type": "string", "minLength": 1 },
          "locator": { "type": "string", "minLength": 1 },
          "support": { "type": "string", "enum": ["supports", "qualifies", "contradicts"] }
        }
      }
    }
  }
}
